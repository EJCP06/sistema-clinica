# ============================================================
# VARIABLES DE ENTORNO DEL SISTEMA (raíz: .env)
# Copia este archivo a .env y completa los valores reales.
# La versión completa y comentada está en backend/.env.example
# (el backend carga backend/.env, que se puede crear desde ese template).
# ============================================================

# ────────────────────────────────────────
# BACKEND
# ────────────────────────────────────────
# Puerto HTTP del backend (desarrollo 3001; Docker 3000).
PORT=3001
# development | production
NODE_ENV=development

# ────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=clinica_colas

# ────────────────────────────────────────
# JWT (autenticación)
# ────────────────────────────────────────
# Secreto para firmar tokens (cambiarlo en producción).
JWT_SECRET=change_this_to_a_random_secret_key

# ────────────────────────────────────────
# CORS (orígenes permitidos separados por coma)
# ────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200,http://localhost
