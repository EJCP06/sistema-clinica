# ============================================================
# .dockerignore — archivos que NO entran al contexto de build de Docker
# (se excluyen dependencias, código fuente y archivos locales para que la
# imagen solo contenga lo necesario; el backend se copia explícitamente
# vía Dockerfile.backend y el frontend se compila en un stage previo).
# ============================================================
node_modules
npm-debug.log
dist
.git
.gitignore
README.md
.vscode
.angular
src
public
proxy.conf.js
angular.json
tailwind.config.js
tsconfig.json
tsconfig.app.json
.eslintrc.json
.prettierrc
.editorconfig
.env
backend/logs
backend/.env
