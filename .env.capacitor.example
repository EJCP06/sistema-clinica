# ============================================================
# VARIABLES DE ENTORNO PARA CAPACITOR (Android/iOS)
# Copia este archivo a .env.capacitor y completa los valores reales:
#   cp .env.capacitor.example .env.capacitor
# NO subas .env.capacitor a Git (ya está en .gitignore).
# ============================================================

# Dominio público de producción (URL del backend accesible desde internet)
CAPACITOR_API_URL=https://tu-dominio.example/api
CAPACITOR_SOCKET_URL=https://tu-dominio.example

# Fallback: IP interna del servidor en la red local de la clínica
# (se usa cuando el dominio público no responde)
CAPACITOR_API_URL_FALLBACK=http://192.168.1.100:3001/api
CAPACITOR_SOCKET_URL_FALLBACK=http://192.168.1.100:3001
