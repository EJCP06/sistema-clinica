# ============================================================
# Dockerfile del FRONTEND (build multi-stage)
# ------------------------------------------------------------
# Stage 1 (build): compila la aplicación Angular a archivos estáticos.
# Stage 2 (nginx): sirve esos archivos con Nginx y usa nginx.conf como
# reverse proxy hacia el backend (contenedor 'api'). El entrypoint
# docker-entrypoint.sh sustituye la variable ${NGINX_DOMAIN} en el conf.
# ============================================================

# Stage 1: Compilar la aplicación Angular
FROM node:20-alpine AS build

WORKDIR /usr/src/app

# package*.json primero para aprovechar la caché de capas de Docker.
COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# Stage 2: Servir los estáticos con Nginx
FROM nginx:alpine

# gettext provee 'envsubst', usado por docker-entrypoint.sh para
# sustituir ${NGINX_DOMAIN} dentro de nginx.conf.
RUN apk add --no-cache gettext

# Resultado del build de Angular (carpeta 'browser' en Angular 17+).
COPY --from=build /usr/src/app/dist/sistema-clinica/browser /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
