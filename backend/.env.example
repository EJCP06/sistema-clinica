# ============================================================
# VARIABLES DE ENTORNO DEL BACKEND (backend/.env)
# Copia este archivo a backend/.env y completa los valores reales.
# El backend carga este archivo al arrancar (backend/index.js).
# ============================================================

# ────────────────────────────────────────
# BACKEND
# ────────────────────────────────────────
# Puerto HTTP donde escucha el backend (en desarrollo 3001; en Docker 3000).
PORT=3001
# development | production (cambia logs, cookies seguras y HSTS).
NODE_ENV=development

# ────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=clinica_colas

# ────────────────────────────────────────
# JWT (autenticación)
# ────────────────────────────────────────
# Secreto con el que se firman los access tokens (IMPORTANTE: cambiarlo
# en producción; debe ser largo y aleatorio).
JWT_SECRET=change_this_to_a_random_secret_key

# ────────────────────────────────────────
# CORS (orígenes permitidos separados por coma)
# ────────────────────────────────────────
# Sin CORS_ORIGIN, en desarrollo se usa por defecto
# http://localhost:4200,http://localhost:4201,http://localhost
CORS_ORIGIN=http://localhost:4200,http://localhost

# ────────────────────────────────────────
# EMAIL (SMTP para la recuperación de contraseña)
# ────────────────────────────────────────
# Ejemplo con Gmail: EMAIL_PORT=587 + App Password en EMAIL_PASS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Remitente visible en los correos OTP.
EMAIL_FROM="Clínica Nueva Caracas"

# ────────────────────────────────────────
# RATE LIMITING (protección contra abusos)
# ────────────────────────────────────────
# Ventana en ms y máximo de peticiones por IP para la API general
# (ver backend/src/middleware/rateLimiter.js).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
